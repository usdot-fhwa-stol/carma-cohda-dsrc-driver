{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build V2X ROS Driver",
            "type": "shell",
            "command": "colcon build --packages-up-to v2x_ros_driver --parallel-workers $(nproc) --cmake-args -DCMAKE_BUILD_TYPE=Release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "Run V2X ROS Driver Unit Tests",
            "type": "shell",
            "command": "colcon test --packages-select v2x_ros_driver --event-handler console_direct+",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
